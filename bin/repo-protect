#!/usr/bin/env bash
# Protect the default branch with a ruleset, and enable free security features.
set -euo pipefail

RT_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=lib/common.sh
source "$RT_ROOT/lib/common.sh"
# shellcheck source=lib/compare.sh
source "$RT_ROOT/lib/compare.sh"

RT_RULESET_NAME="repo-tools: default branch"
RT_APPROVALS="${RT_APPROVALS:-0}"
RT_BYPASS="${RT_BYPASS:-pull_request}"
RT_INCLUDE_PRIVATE="${RT_INCLUDE_PRIVATE:-0}"
RT_CODEQL="${RT_CODEQL:-1}"
GITHUB_ACTIONS_APP_ID=15368 # pins the required check to GitHub Actions
REPO_ADMIN_ROLE_ID=5

usage() {
  cat <<EOF
Usage: $(basename "$0") [options] REPO...

All repos:
  - delete head branches after merge
  - GitHub Actions: workflows get a read-only GITHUB_TOKEN unless they declare
    more in \`permissions:\`, and can't create or approve pull requests
    (workflows that don't declare \`permissions:\` are listed first)
Public repos (or private with --include-private, which needs a paid plan):
  - secret scanning + push protection, private vulnerability reporting and
    CodeQL code scanning "default setup" (public only; a repo already running
    its own CodeQL workflow is left alone)
  - ruleset "$RT_RULESET_NAME" on the default branch: no deletion or force
    push, changes via PR only, and "$RT_CI_CHECK_NAME" must pass once
    $RT_CI_FILE is on the default branch (re-run after merging the CI PR)

REPO is "owner/name", or "name" for repos you own.

Options:
  -n, --dry-run           Show what would change without changing anything
      --include-private   Also apply rulesets to private repos (GitHub Pro)
  -h, --help              Show this help

Environment:
  RT_APPROVALS  Required approving reviews (default: 0, as you can't approve your own PRs)
  RT_BYPASS     Admin bypass: pull_request (default; can override failing checks on
                a PR, but can't push directly), always, or none
  RT_CODEQL     1 (default) enables CodeQL default setup on public repos; 0 skips it
EOF
}

ruleset_json() { # REQUIRE_CHECK(true|false)
  jq -n \
    --arg name "$RT_RULESET_NAME" \
    --arg bypass "$RT_BYPASS" \
    --arg check "$RT_CI_CHECK_NAME" \
    --argjson approvals "$RT_APPROVALS" \
    --argjson require_check "$1" \
    --argjson app_id "$GITHUB_ACTIONS_APP_ID" \
    --argjson admin_role "$REPO_ADMIN_ROLE_ID" \
    '{
      name: $name,
      target: "branch",
      enforcement: "active",
      conditions: { ref_name: { include: ["~DEFAULT_BRANCH"], exclude: [] } },
      bypass_actors: (if $bypass == "none" then [] else
        [{ actor_id: $admin_role, actor_type: "RepositoryRole", bypass_mode: $bypass }] end),
      rules: ([
        { type: "deletion" },
        { type: "non_fast_forward" },
        { type: "pull_request", parameters: {
            required_approving_review_count: $approvals,
            dismiss_stale_reviews_on_push: true,
            require_code_owner_review: false,
            require_last_push_approval: false,
            required_review_thread_resolution: false } }
      ] + (if $require_check then [
        { type: "required_status_checks", parameters: {
            strict_required_status_checks_policy: false,
            do_not_enforce_on_create: true,
            required_status_checks: [{ context: $check, integration_id: $app_id }] } }
      ] else [] end))
    }'
}

# CodeQL "default setup": GitHub picks the languages and keeps the queries
# current, with no workflow file in the repo. Repos running their own CodeQL
# workflow ("advanced setup") can't use it; the API refuses and we move on.
enable_codeql() {
  local state
  state=$(gh api "repos/$RT_REPO/code-scanning/default-setup" --jq .state 2>/dev/null) || state=unknown
  if [[ $state == configured ]]; then
    ok "CodeQL default setup already on"
  elif rt_api PATCH "repos/$RT_REPO/code-scanning/default-setup" '{"state": "configured"}' 2>/dev/null; then
    rt_done "CodeQL default setup enabled"
  else
    warn "could not enable CodeQL default setup (most likely the repo has its own CodeQL workflow); leaving it as is"
  fi
}

# Lists default-branch workflows that rely on the repo's default token
# permissions, which restrict_actions_token is about to make read-only.
warn_workflows_without_permissions() {
  local ref name file
  file="$(rt_tmpdir)/workflow.yml"
  ref=$(jq -rn --arg b "$RT_DEFAULT_BRANCH" '$b | @uri')
  while IFS= read -r name; do
    gh api -H "Accept: application/vnd.github.raw+json" \
      "repos/$RT_REPO/contents/.github/workflows/$(jq -rn --arg n "$name" '$n | @uri')?ref=$ref" \
      >"$file" 2>/dev/null || continue
    if rt_workflow_lacks_permissions "$file"; then
      warn "$name doesn't declare \`permissions:\` for every job, so it gets the default token: read-only from now on."
      warn "  If it needs to write (push, releases, PR comments...), declare it there, e.g. \`permissions: { contents: write }\`."
    fi
  done < <(gh api "repos/$RT_REPO/contents/.github/workflows?ref=$ref" \
    --jq '.[] | select(.type == "file" and (.name | test("\\.ya?ml$"))) | .name' 2>/dev/null || true)
}

# Default GITHUB_TOKEN to read-only, and stop workflows creating/approving
# PRs (an approval from the token could satisfy a required review).
restrict_actions_token() {
  local current want='{"default_workflow_permissions": "read", "can_approve_pull_request_reviews": false}'
  current=$(gh api "repos/$RT_REPO/actions/permissions/workflow" 2>/dev/null) || current='null'
  if jq -e '.default_workflow_permissions == "read" and .can_approve_pull_request_reviews == false' \
    <<<"$current" >/dev/null 2>&1; then
    ok "Actions token already read-only by default; workflows can't approve PRs"
    return 0
  fi
  warn_workflows_without_permissions
  if rt_api PUT "repos/$RT_REPO/actions/permissions/workflow" "$want"; then
    rt_done "Actions token read-only by default; workflows can't create or approve PRs"
  else
    warn "could not change the Actions token defaults (an organization policy may control them)"
  fi
}

process() {
  local id require_check=false
  log "Protect: $1"
  rt_load_repo "$(rt_resolve_repo "$1")"
  rt_check_repo_usable

  rt_api PATCH "repos/$RT_REPO" '{"delete_branch_on_merge": true}'
  # Read it back: the setting is easy to miss in the UI, and only affects PRs
  # merged after it is on (and never a branch another open PR still uses).
  if ((!RT_DRY_RUN)) && [[ $(gh api "repos/$RT_REPO" --jq .delete_branch_on_merge) != true ]]; then
    warn "delete branch on merge did not stick (GitHub still reports it off); check Settings > General"
  else
    rt_done "delete branch on merge enabled"
  fi

  restrict_actions_token

  if rt_is_public; then
    if rt_api PATCH "repos/$RT_REPO" '{"security_and_analysis": {
      "secret_scanning": {"status": "enabled"},
      "secret_scanning_push_protection": {"status": "enabled"}}}'; then
      rt_done "secret scanning + push protection enabled"
    else
      warn "could not enable secret scanning"
    fi
    if rt_api PUT "repos/$RT_REPO/private-vulnerability-reporting"; then
      rt_done "private vulnerability reporting enabled"
    else
      warn "could not enable private vulnerability reporting"
    fi
    if ((RT_CODEQL)); then enable_codeql; fi
  elif ((RT_INCLUDE_PRIVATE)); then
    info "private repo: applying ruleset only (--include-private)"
  else
    info "private repo: rulesets need GitHub Pro; skipping (use --include-private if you have it)"
    return 0
  fi

  if gh api "repos/$RT_REPO/contents/$RT_CI_FILE?ref=$(jq -rn --arg b "$RT_DEFAULT_BRANCH" '$b | @uri')" \
    --silent 2>/dev/null; then
    require_check=true
  else
    warn "$RT_CI_FILE isn't on $RT_DEFAULT_BRANCH yet, so '$RT_CI_CHECK_NAME' won't be required."
    warn "Merge the repo-ci PR, then re-run repo-protect."
  fi

  id=$(gh api "repos/$RT_REPO/rulesets?includes_parents=false" \
    --jq ".[] | select(.name == \"$RT_RULESET_NAME\") | .id")
  if [[ -n $id ]]; then
    rt_api PUT "repos/$RT_REPO/rulesets/$id" "$(ruleset_json "$require_check")"
    rt_done "ruleset updated (required check: $require_check)"
  else
    rt_api POST "repos/$RT_REPO/rulesets" "$(ruleset_json "$require_check")"
    rt_done "ruleset created (required check: $require_check)"
  fi
}

args=()
for arg in "$@"; do
  case $arg in
    --include-private) RT_INCLUDE_PRIVATE=1 ;;
    *) args+=("$arg") ;;
  esac
done
rt_parse_args "${args[@]+"${args[@]}"}"
rt_require gh jq
[[ $RT_APPROVALS =~ ^[0-9]+$ ]] || die "RT_APPROVALS must be a number"
[[ $RT_CODEQL == [01] ]] || die "RT_CODEQL must be 0 or 1"
case $RT_BYPASS in pull_request | always | none) ;; *) die "RT_BYPASS must be pull_request, always or none" ;; esac
if ((RT_APPROVALS > 0)) && [[ $RT_BYPASS == none ]]; then
  warn "RT_APPROVALS=$RT_APPROVALS with no bypass: you won't be able to merge your own PRs alone"
fi
rt_for_each_repo process "${RT_ARGS[@]+"${RT_ARGS[@]}"}"
