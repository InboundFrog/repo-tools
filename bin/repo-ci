#!/usr/bin/env bash
# PR a generated CI workflow that calls the shared reusable workflows.
set -euo pipefail

RT_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=lib/common.sh
source "$RT_ROOT/lib/common.sh"
# shellcheck source=lib/detect.sh
source "$RT_ROOT/lib/detect.sh"
# shellcheck source=lib/render.sh
source "$RT_ROOT/lib/render.sh"
# shellcheck source=lib/gitops.sh
source "$RT_ROOT/lib/gitops.sh"
# shellcheck source=lib/compare.sh
source "$RT_ROOT/lib/compare.sh"

usage() {
  cat <<EOF
Usage: $(basename "$0") [options] REPO...

Detects the languages in each repo and opens a PR adding $RT_CI_FILE.
Workflows listed in REPLACE_WORKFLOWS in $RT_CONF_FILE are removed in the
same PR.
It calls the reusable workflows in $RT_SOURCE_REPO@$RT_REF, so later changes to
those roll out without touching the repo again. A final "$RT_CI_CHECK_NAME" job
gives branch protection one stable check to require.

REPO is "owner/name", or "name" for repos you own.

Options:
  -n, --dry-run   Show what would change without changing anything
  -f, --force     Replace an existing $RT_CI_FILE not created by repo-tools
  -h, --help      Show this help

Environment:
  RT_SOURCE_REPO  Repo hosting the reusable workflows (default: $RT_SOURCE_REPO)
  RT_REF          Ref the generated workflow pins to (default: $RT_REF)
EOF
}

process() {
  local dir content plan body wf removed_md
  local -a removed=() overlap=()
  log "CI: $1"
  rt_load_repo "$(rt_resolve_repo "$1")"
  rt_check_repo_usable

  dir=$(rt_clone "$RT_REPO")
  rt_conf_load "$dir"
  plan=$(rt_ci_plan "$dir")
  [[ -n $plan ]] || warn "no languages detected; the workflow will only contain the '$RT_CI_CHECK_NAME' job"
  content=$(rt_render_ci "$dir" "$RT_DEFAULT_BRANCH")
  rt_write_managed "$dir" "$RT_CI_FILE" <<<"$content" || return 0
  mapfile -t removed < <(rt_replace_workflows "$dir")
  mapfile -t overlap < <(rt_overlapping_workflows "$dir")
  for wf in "${overlap[@]+"${overlap[@]}"}"; do
    warn "$wf also runs on push/pull_request; if this CI replaces it, add REPLACE_WORKFLOWS=$wf to $RT_CONF_FILE"
  done

  removed_md=''
  if ((${#removed[@]})); then
    # shellcheck disable=SC2016 # Markdown backticks
    removed_md=$(printf 'Removes, as listed in `REPLACE_WORKFLOWS`:\n'; printf -- '- `%s`\n' "${removed[@]}")$'\n\n'
  fi
  body=$(
    cat <<EOF
Adds \`$RT_CI_FILE\`, generated by [repo-tools](https://github.com/$RT_SOURCE_REPO).

Jobs (directories):
$(if [[ -n $plan ]]; then awk -F'\t' '{ printf "- `%s`: %s\n", $1, $2 }' <<<"$plan"; else echo "- none detected"; fi)

${removed_md}Each job runs lint, test and build for its language. \`$RT_CI_CHECK_NAME\` passes only when every job does, and is the check branch protection requires.
To customise (versions, commands, directories), add \`$RT_CONF_FILE\` and re-run \`repo-ci\` rather than editing this file.
EOF
  )
  rt_publish_pr "$dir" repo-tools/ci "ci: add repo-tools CI workflow" "$body" "$RT_CI_FILE" "${removed[@]+"${removed[@]}"}"
}

rt_parse_args "$@"
rt_require gh git jq
rt_for_each_repo process "${RT_ARGS[@]+"${RT_ARGS[@]}"}"
