#!/usr/bin/env bash
# PR a generated CI workflow that calls the shared reusable workflows.
set -euo pipefail

RT_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=lib/common.sh
source "$RT_ROOT/lib/common.sh"
# shellcheck source=lib/detect.sh
source "$RT_ROOT/lib/detect.sh"
# shellcheck source=lib/render.sh
source "$RT_ROOT/lib/render.sh"
# shellcheck source=lib/gitops.sh
source "$RT_ROOT/lib/gitops.sh"
# shellcheck source=lib/compare.sh
source "$RT_ROOT/lib/compare.sh"

usage() {
  cat <<EOF
Usage: $(basename "$0") [options] REPO...

Detects the languages in each repo and opens a PR adding $RT_CI_FILE.
Workflows listed in REPLACE_WORKFLOWS in $RT_CONF_FILE are removed in the
same PR.
It calls the reusable workflows in $RT_SOURCE_REPO, pinned to the commit of its
newest vX.Y.Z release; Dependabot then proposes each later release as a PR.
A final "$RT_CI_CHECK_NAME" job gives branch protection one stable check to require.

REPO is "owner/name", or "name" for repos you own.

Options:
  -n, --dry-run   Show what would change without changing anything
  -f, --force     Replace an existing $RT_CI_FILE not created by repo-tools
  -h, --help      Show this help

Environment:
  RT_SOURCE_REPO  Repo hosting the reusable workflows (default: $RT_SOURCE_REPO)
  RT_REF          Ref the generated workflow pins to instead (e.g. main, or a
                  SHA). Default: the newest vX.Y.Z tag, as its commit SHA
EOF
}

process() {
  local dir content plan body wf removed_md names n c ctx src pkgs blocked_md='' apt_md='' notes_md=''
  local -a removed=() overlap=()
  log "CI: $1"
  rt_load_repo "$(rt_resolve_repo "$1")"
  rt_check_repo_usable

  dir=$(rt_clone "$RT_REPO")
  rt_conf_load "$dir"
  plan=$(rt_ci_plan "$dir")
  [[ -n $plan ]] || warn "no languages detected; the workflow will only contain the '$RT_CI_CHECK_NAME' job"
  content=$(rt_render_ci "$dir" "$RT_DEFAULT_BRANCH")
  rt_write_managed "$dir" "$RT_CI_FILE" <<<"$content" || return 0
  mapfile -t removed < <(rt_replace_workflows "$dir")
  mapfile -t overlap < <(rt_overlapping_workflows "$dir")
  for wf in "${overlap[@]+"${overlap[@]}"}"; do
    warn "$wf also runs on push/pull_request; if this CI replaces it, add REPLACE_WORKFLOWS=$wf to $RT_CONF_FILE"
  done

  # A rule still requiring a check from a workflow this PR deletes would
  # leave this PR, and every later one, waiting for a check that never runs.
  if ((${#removed[@]})); then
    names=''
    for wf in "${removed[@]}"; do
      git -C "$dir" show "HEAD:$wf" >"$(rt_tmpdir)/replaced.yml" 2>/dev/null || continue
      if n=$(rt_workflow_check_names "$(rt_tmpdir)/replaced.yml"); then
        while IFS= read -r c; do [[ -z $c ]] || names+="${wf##*/}"$'\t'"$c"$'\n'; done <<<"$n"
      else
        warn "can't read $wf (needs yq, or python3 + PyYAML) to check whether a rule requires its checks"
      fi
    done
    while IFS=$'\t' read -r ctx src wf; do
      [[ -n $ctx ]] || continue
      warn "$src requires \"$ctx\", which $wf produces. With $wf gone that check never reports, so this PR stays blocked: change the rule to require \"$RT_CI_CHECK_NAME\" instead."
      blocked_md+="- $src requires \`$ctx\`, from \`$wf\`"$'\n'
    done < <(rt_match_required "$(rt_required_checks)" "$names")
  fi

  # System packages hand-written workflows install that the generated CI won't.
  while IFS=$'\t' read -r wf pkgs; do
    [[ -n $wf ]] || continue
    warn "$wf installs $pkgs with apt, but the generated CI doesn't; if the build needs them, add APT_PACKAGES=$pkgs (or <LANGUAGE>_APT_PACKAGES) to $RT_CONF_FILE"
    apt_md+="- \`$wf\` installs \`$pkgs\`"$'\n'
  done < <(rt_apt_suggestions "$dir")

  if [[ -n $blocked_md ]]; then
    notes_md+="**Before merging:** these rules require checks from the workflows this PR removes, which will never report again. Change them to require \`$RT_CI_CHECK_NAME\`, or this PR stays blocked:"$'\n'"$blocked_md"$'\n'
  fi
  if [[ -n $apt_md ]]; then
    notes_md+="**System packages:** hand-written workflows install these with apt, but the generated CI doesn't. If a build fails on a missing library, add them to \`APT_PACKAGES\` in \`$RT_CONF_FILE\`:"$'\n'"$apt_md"$'\n'
  fi

  removed_md=''
  if ((${#removed[@]})); then
    # shellcheck disable=SC2016 # Markdown backticks
    removed_md=$(printf 'Removes, as listed in `REPLACE_WORKFLOWS`:\n'; printf -- '- `%s`\n' "${removed[@]}")$'\n\n'
  fi
  body=$(
    cat <<EOF
Adds \`$RT_CI_FILE\`, generated by [repo-tools](https://github.com/$RT_SOURCE_REPO).

Jobs (directories):
$(if [[ -n $plan ]]; then rt_md_plan <<<"$plan"; else echo "- none detected"; fi)

${removed_md}${notes_md}Each job runs lint, test and build for its language. \`$RT_CI_CHECK_NAME\` passes only when every job does, and is the check branch protection requires.
To customise (versions, commands, directories), add \`$RT_CONF_FILE\` and re-run \`repo-ci\` rather than editing this file.
EOF
  )
  rt_publish_pr "$dir" repo-tools/ci "ci: add repo-tools CI workflow" "$body" "$RT_CI_FILE" "${removed[@]+"${removed[@]}"}"
}

rt_parse_args "$@"
rt_require gh git jq
rt_resolve_ref || exit 1
log "Reusable workflows: $RT_SOURCE_REPO@$RT_REF${RT_REF_COMMENT:+ ($RT_REF_COMMENT)}"
rt_for_each_repo process "${RT_ARGS[@]+"${RT_ARGS[@]}"}"
