#!/usr/bin/env bash
# Enable Dependabot alerts + security updates, and PR a generated dependabot.yml.
set -euo pipefail

RT_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=lib/common.sh
source "$RT_ROOT/lib/common.sh"
# shellcheck source=lib/detect.sh
source "$RT_ROOT/lib/detect.sh"
# shellcheck source=lib/render.sh
source "$RT_ROOT/lib/render.sh"
# shellcheck source=lib/gitops.sh
source "$RT_ROOT/lib/gitops.sh"
# shellcheck source=lib/compare.sh
source "$RT_ROOT/lib/compare.sh"

usage() {
  cat <<EOF
Usage: $(basename "$0") [options] REPO...

Enables Dependabot alerts and security updates, then opens a PR adding a
generated $RT_DEPENDABOT_FILE (version updates for every detected ecosystem).

REPO is "owner/name", or "name" for repos you own.

Options:
  -n, --dry-run   Show what would change without changing anything
  -f, --force     Replace an existing dependabot.yml not created by repo-tools
                  (without it, a comparison with the generated file is shown).
                  Its ignore rules, interval and cooldown are carried over into
                  $RT_CONF_FILE; if anything else would be lost, it stops
      --accept-loss  With --force: replace it even if some settings are lost
  -h, --help      Show this help
EOF
}

process() {
  local dir content ecosystems body intro extra='' takeover=0 l
  local -a paths=("$RT_DEPENDABOT_FILE")
  RT_MIGRATED=() RT_LOST=() RT_NOTES=()
  log "Dependabot: $1"
  rt_load_repo "$(rt_resolve_repo "$1")"
  rt_check_repo_usable

  rt_api PUT "repos/$RT_REPO/vulnerability-alerts"
  rt_done "Dependabot alerts enabled"
  rt_api PUT "repos/$RT_REPO/automated-security-fixes"
  rt_done "Dependabot security updates enabled"

  dir=$(rt_clone "$RT_REPO")
  rt_conf_load "$dir"
  content=$(rt_render_dependabot "$dir")
  if rt_path_inside "$dir" "$RT_DEPENDABOT_FILE" && [[ -f $dir/$RT_DEPENDABOT_FILE ]] &&
    ! grep -qF "$RT_MARKER" "$dir/$RT_DEPENDABOT_FILE"; then
    info "existing $RT_DEPENDABOT_FILE compared with what repo-tools would generate:"
    printf '%s\n' "$content" >"$(rt_tmpdir)/dependabot.yml"
    rt_compare_dependabot "$dir/$RT_DEPENDABOT_FILE" "$(rt_tmpdir)/dependabot.yml" | sed 's/^/  /' >&2
    if ((RT_FORCE)); then
      rt_dependabot_takeover "$dir" "$(rt_tmpdir)/dependabot.yml" || return 0
      takeover=1
      if ((${#RT_MIGRATED[@]})); then
        content=$(rt_render_dependabot "$dir")
        paths+=("$RT_CONF_FILE")
      fi
    fi
  fi
  rt_write_managed "$dir" "$RT_DEPENDABOT_FILE" <<<"$content" || return 0

  ecosystems=$(rt_detect_ecosystems "$dir" | rt_md_plan)
  intro="Adds \`$RT_DEPENDABOT_FILE\`"
  if ((takeover)); then
    intro="Replaces the hand-written \`$RT_DEPENDABOT_FILE\` with one"
    if ((${#RT_MIGRATED[@]})); then
      extra+=$'\n'"Carried over from the old file into \`$RT_CONF_FILE\`, so these keep working:"$'\n'
      for l in "${RT_MIGRATED[@]}"; do extra+="- \`$l\`"$'\n'; done
    fi
    if ((${#RT_LOST[@]})); then
      extra+=$'\n'"**Not carried over** (\`$RT_CONF_FILE\` can't express these; replaced with \`--accept-loss\`):"$'\n'
      for l in "${RT_LOST[@]}"; do extra+="- $l"$'\n'; done
    fi
    if ((${#RT_NOTES[@]})); then
      extra+=$'\n'"Changed on purpose:"$'\n'
      for l in "${RT_NOTES[@]}"; do extra+="- $l"$'\n'; done
    fi
  fi
  body=$(
    cat <<EOF
${intro}, generated by [repo-tools](https://github.com/$RT_SOURCE_REPO).

Detected ecosystems (directories):
$ecosystems

Minor and patch updates are grouped into one PR per ecosystem; major updates get their own.
${extra}
To customise, add \`$RT_CONF_FILE\` and re-run \`repo-dependabot\` rather than editing this file.
EOF
  )
  rt_publish_pr "$dir" repo-tools/dependabot "chore: configure Dependabot version updates" "$body" "${paths[@]}"
}

rt_parse_args "$@"
rt_require gh git jq
rt_for_each_repo process "${RT_ARGS[@]+"${RT_ARGS[@]}"}"
